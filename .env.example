# QA Lab (/qa-lab) — copy these into .env.local for local dev and into
# Vercel → Project → Settings → Environment Variables for production.

# Required. Anyone running a test must enter this passcode.
QA_TOOL_PASSCODE=

# AI tester + Logo Lab (/logo-lab). Free key from https://aistudio.google.com/apikey (Gemini).
# Without a key the tool still runs automated checks + a scripted walkthrough.
LLM_API_KEY=

# Optional: switch to any OpenAI-compatible provider (defaults to Gemini).
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest
# LLM_MIN_INTERVAL_MS=4000      # spacing between LLM calls (free-tier rate limits)

# Optional tuning
# QA_MAX_TURNS=12               # AI decisions per device
# QA_TIME_BUDGET_MS=250000      # must stay under the 300 s Vercel function limit
# CHROME_PATH=                  # local dev only, if Chrome/Edge isn't auto-detected
# QA_ALLOW_PRIVATE=1            # local dev only: allow testing localhost sites

# Thumbnail Lab (/thumbnail-lab) uses LLM_API_KEY for concepts and Gemini image models for background art.
# GEMINI_API_KEY=               # only needed if LLM_BASE_URL points at a non-Gemini provider
# THUMB_IMAGE_MODELS=gemini-2.5-flash-image,gemini-2.0-flash-preview-image-generation
